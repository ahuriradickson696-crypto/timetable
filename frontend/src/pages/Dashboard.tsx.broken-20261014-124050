import { useEffect, useState } from "react";
import { Link } from "react-router-dom";
import { api, TimetableRun } from "../api/client";
import { CardSkeleton } from "../components/ui/Skeleton";
import { useToast } from "../components/ui/Toast";
import { useAuth } from "../store/auth";

interface Stats {
  programmes: number;
  cohorts: number;
  course_units: number;
  lecturers: number;
  rooms: number;
  activities: number;
  exam_activities: number;
  runs: number;
}

interface NextClass {
  day: string;
  start_time: string;
  end_time: string;
  module_code: string;
  module_name: string;
  room_code?: string;
  room_name?: string;
  lecturer_name?: string;
  cohort_id: string;
}

interface TodayClass {
  period_id: string;
  start_time: string;
  end_time: string;
  module_code: string;
  module_name: string;
  room_code?: string;
  lecturer_name?: string;
}

export default function Dashboard() {
  const user = useAuth((s) => s.user);
  if (user?.role === "student") return <StudentDashboard />;
  if (user?.role === "lecturer") return <LecturerDashboard />;
  return <AdminDashboard />;
}

/* ============================================================
   STUDENT DASHBOARD
   ============================================================ */
function StudentDashboard() {
  const user = useAuth((s) => s.user);
  const toast = useToast();
  const [nextClass, setNextClass] = useState<NextClass | null>(null);
  const [today, setToday] = useState<TodayClass[]>([]);
  const [enrollCount, setEnrollCount] = useState<number>(0);
  const [cohortId, setCohortId] = useState<string>("");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const load = async () => {
      try {
        const [n, t, m] = await Promise.allSettled([
          api.get("/portal/my-next-class"),
          api.get("/portal/my-today"),
          api.get("/enrollments/me"),
        ]);
        if (n.status === "fulfilled" && n.value.data && n.value.data.module_code) {
          setNextClass(n.value.data);
        }
        if (t.status === "fulfilled") {
          setToday(Array.isArray(t.value.data) ? t.value.data : []);
        }
        if (m.status === "fulfilled") {
          const arr = Array.isArray(m.value.data) ? m.value.data : [];
          setEnrollCount(arr.length);
          if (arr[0]?.cohort_id) setCohortId(arr[0].cohort_id);
        }
      } catch {
        toast.show("err", "Failed to load your dashboard");
      } finally {
        setLoading(false);
      }
    };
    load();
  }, []);

  const greeting = () => {
    const h = new Date().getHours();
    if (h < 12) return "Good morning";
    if (h < 17) return "Good afternoon";
    return "Good evening";
  };

  const timeUntil = (start: string) => {
    try {
      const [h, m] = start.split(":").map(Number);
      const now = new Date();
      const target = new Date();
      target.setHours(h, m, 0, 0);
      const diff = target.getTime() - now.getTime();
      if (diff < 0) return "now";
      const mins = Math.floor(diff / 60000);
      if (mins < 60) return "in " + mins + " min";
      const hrs = Math.floor(mins / 60);
      return "in " + hrs + "h " + (mins % 60) + "m";
    } catch {
      return "";
    }
  };

  if (loading) {
    return (
      <div className="space-y-4">
        <div className="h-8 bg-gray-100 rounded w-64 animate-pulse" />
        <CardSkeleton />
        <div className="grid md:grid-cols-3 gap-4">
          <CardSkeleton /><CardSkeleton /><CardSkeleton />
        </div>
      </div>
    );
  }

  return (
    <div>
      <div className="mb-8">
        <h1 className="text-2xl md:text-3xl font-bold text-gray-900 mb-1">
          {greeting()}, {user?.full_name?.split(" ")[0] || "Student"}
        </h1>
        <p className="text-gray-500">
          {cohortId ? (
            <>
              You are enrolled in <strong>{enrollCount}</strong> modules
              {cohortId && <> in cohort <span className="font-mono text-xs">{cohortId}</span></>}
            </>
          ) : (
            "Here is your day at a glance."
          )}
        </p>
      </div>

      <div className="bg-gradient-to-br from-aviu-800 to-aviu-900 text-white rounded-2xl p-6 md:p-8 mb-6 shadow-sm">
        <div className="text-aviu-200 text-xs uppercase tracking-wider mb-2">
          Next Class
        </div>
        {nextClass ? (
          <>
            <div className="flex items-start justify-between gap-4 flex-wrap">
              <div className="flex-1 min-w-[200px]">
                <div className="text-3xl font-bold mb-1 font-mono">{nextClass.module_code}</div>
                <div className="text-aviu-100 text-base mb-3">{nextClass.module_name}</div>
                <div className="flex flex-wrap gap-x-6 gap-y-2 text-sm text-aviu-200">
                  <span>Day: {nextClass.day}</span>
                  <span>Time: {nextClass.start_time} - {nextClass.end_time}</span>
                  {nextClass.room_code && (
                    <span>Room: {nextClass.room_name || nextClass.room_code}</span>
                  )}
                  {nextClass.lecturer_name && (
                    <span>Lecturer: {nextClass.lecturer_name}</span>
                  )}
                </div>
              </div>
              <div className="text-right">
                <div className="text-aviu-200 text-xs uppercase tracking-wider">Starts</div>
                <div className="text-2xl font-bold">{timeUntil(nextClass.start_time)}</div>
              </div>
            </div>
            <div className="mt-5 flex gap-3 flex-wrap">
              <Link to="/my-timetable"
                className="bg-white text-aviu-900 font-semibold px-4 py-2 rounded-lg hover:bg-aviu-100 transition text-sm">
                View Full Timetable
              </Link>
              {nextClass.room_code && (
                <a href={"https://www.google.com/maps/search/?api=1&query=" + encodeURIComponent((nextClass.room_name || nextClass.room_code) + " AVIU")}
                  target="_blank" rel="noreferrer"
                  className="bg-aviu-700/50 text-white font-semibold px-4 py-2 rounded-lg hover:bg-aviu-700 transition text-sm border border-aviu-600">
                  Find Room
                </a>
              )}
            </div>
          </>
        ) : (
          <>
            <div className="text-2xl font-bold mb-1">No upcoming class</div>
            <p className="text-aviu-200 mb-4">Enjoy the break. Nothing on the schedule right now.</p>
            <Link to="/my-timetable"
              className="inline-block bg-white text-aviu-900 font-semibold px-4 py-2 rounded-lg hover:bg-aviu-100 transition text-sm">
              View Full Timetable
            </Link>
          </>
        )}
      </div>

      <div className="bg-white border border-gray-200 rounded-2xl p-6 mb-6">
        <div className="flex items-center justify-between mb-4">
          <h2 className="text-lg font-bold text-gray-900">Today's Classes</h2>
          <span className="text-xs text-gray-500">{today.length} scheduled</span>
        </div>
        {today.length === 0 ? (
          <div className="text-center py-8 text-gray-500">
            <div className="text-sm">No classes today.</div>
          </div>
        ) : (
          <div className="space-y-2">
            {today.map((c, i) => (
              <div key={i}
                className="flex items-center justify-between p-3 border border-gray-100 rounded-lg hover:bg-aviu-50 transition">
                <div className="flex-1">
                  <div className="flex items-center gap-2 mb-0.5">
                    <span className="font-mono font-semibold text-sm">{c.module_code}</span>
                    <span className="text-xs text-gray-500">
                      {c.start_time} - {c.end_time}
                    </span>
                  </div>
                  <div className="text-sm text-gray-700">{c.module_name}</div>
                </div>
                <div className="text-right text-xs text-gray-500">
                  {c.room_code && <div>Room: {c.room_code}</div>}
                  {c.lecturer_name && <div className="mt-0.5">{c.lecturer_name}</div>}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="grid grid-cols-2 md:grid-cols-4 gap-4">
        <QuickLink to="/my-timetable" label="My Timetable" />
        <QuickLink to="/my-modules" label="My Modules" />
        <QuickLink to="/my-exams" label="My Exams" />
        <QuickLink to="/my-schedule" label="Weekly View" />
      </div>

      <div className="mt-6 bg-white border border-gray-200 rounded-2xl p-6">
        <h2 className="text-lg font-bold text-gray-900 mb-3">Sync your timetable</h2>
        <p className="text-sm text-gray-500 mb-4">
          Add your classes to Google Calendar, Apple Calendar, or download as PDF.
        </p>
        <div className="flex flex-wrap gap-3">
          <a href={(api.defaults.baseURL || "") + "/portal/my-timetable/ical"}
            className="bg-aviu-800 hover:bg-aviu-900 text-white font-semibold px-4 py-2 rounded-lg transition text-sm">
            Add to Calendar (iCal)
          </a>
          <a href={(api.defaults.baseURL || "") + "/portal/my-timetable/pdf"}
            className="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold px-4 py-2 rounded-lg transition text-sm">
            Download PDF
          </a>
          <a href={(api.defaults.baseURL || "") + "/portal/my-timetable/excel"}
            className="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold px-4 py-2 rounded-lg transition text-sm">
            Download Excel
          </a>
        </div>
      </div>
    </div>
  );
}

function QuickLink({ to, label }: { to: string; label: string }) {
  return (
    <Link to={to}
      className="bg-white border border-gray-200 rounded-xl p-5 hover:border-aviu-400 hover:shadow-md transition group text-center">
      <div className="text-sm font-medium text-gray-700 group-hover:text-aviu-800">{label}</div>
    </Link>
  );
}

/* ============================================================
   LECTURER DASHBOARD
   ============================================================ */
function LecturerDashboard() {
  const user = useAuth((s) => s.user);
  const toast = useToast();
  const [nextClass, setNextClass] = useState<NextClass | null>(null);
  const [today, setToday] = useState<TodayClass[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const load = async () => {
      try {
        const [n, t] = await Promise.allSettled([
          api.get("/portal/my-next-class"),
          api.get("/portal/my-today"),
        ]);
        if (n.status === "fulfilled" && n.value.data?.module_code) setNextClass(n.value.data);
        if (t.status === "fulfilled") setToday(Array.isArray(t.value.data) ? t.value.data : []);
      } catch {
        toast.show("err", "Failed to load dashboard");
      } finally {
        setLoading(false);
      }
    };
    load();
  }, []);

  if (loading) return <div className="space-y-4"><CardSkeleton /><CardSkeleton /></div>;

  return (
    <div>
      <div className="mb-8">
        <h1 className="text-2xl md:text-3xl font-bold text-gray-900 mb-1">
          Welcome, {user?.full_name?.split(" ")[0] || "Lecturer"}
        </h1>
        <p className="text-gray-500">Your teaching schedule at a glance.</p>
      </div>

      <div className="bg-gradient-to-br from-aviu-800 to-aviu-900 text-white rounded-2xl p-6 md:p-8 mb-6">
        <div className="text-aviu-200 text-xs uppercase tracking-wider mb-2">Next Class</div>
        {nextClass ? (
          <div className="flex items-start justify-between gap-4 flex-wrap">
            <div className="flex-1 min-w-[200px]">
              <div className="text-3xl font-bold mb-1 font-mono">{nextClass.module_code}</div>
              <div className="text-aviu-100 text-base mb-3">{nextClass.module_name}</div>
              <div className="flex flex-wrap gap-x-6 gap-y-2 text-sm text-aviu-200">
                <span>Day: {nextClass.day}</span>
                <span>Time: {nextClass.start_time} - {nextClass.end_time}</span>
                {nextClass.room_code && <span>Room: {nextClass.room_code}</span>}
                <span>Cohort: {nextClass.cohort_id}</span>
              </div>
            </div>
          </div>
        ) : (
          <div className="text-xl font-bold">No upcoming class</div>
        )}
      </div>

      <div className="bg-white border border-gray-200 rounded-2xl p-6">
        <h2 className="text-lg font-bold text-gray-900 mb-4">Today's Teaching</h2>
        {today.length === 0 ? (
          <div className="text-center py-8 text-gray-500 text-sm">No classes today.</div>
        ) : (
          <div className="space-y-2">
            {today.map((c, i) => (
              <div key={i} className="flex items-center justify-between p-3 border rounded-lg">
                <div>
                  <span className="font-mono font-semibold text-sm mr-2">{c.module_code}</span>
                  <span className="text-xs text-gray-500">{c.start_time} - {c.end_time}</span>
                  <div className="text-sm text-gray-700 mt-0.5">{c.module_name}</div>
                </div>
                {c.room_code && <div className="text-xs text-gray-500">Room: {c.room_code}</div>}
              </div>
            ))}
          </div>
        )}
      </div>

      <div className="mt-6 grid grid-cols-2 md:grid-cols-3 gap-4">
        <QuickLink to="/my-schedule" label="My Schedule" />
        <QuickLink to="/my-timetable" label="Full Timetable" />
        <QuickLink to="/my-exams" label="Exams" />
      </div>
    </div>
  );
}

/* ============================================================
   ADMIN DASHBOARD
   ============================================================ */
function AdminDashboard() {
  const toast = useToast();
  const user = useAuth((s) => s.user);
  const [stats, setStats] = useState<Stats>({
    programmes: 0, cohorts: 0, course_units: 0,
    lecturers: 0, rooms: 0, activities: 0, exam_activities: 0, runs: 0,
  });
  const [recentRuns, setRecentRuns] = useState<TimetableRun[]>([]);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const load = async () => {
      try {
        const [p, c, cu, l, r, a, exam, runs] = await Promise.all([
          api.get("/programmes"),
          api.get("/cohorts"),
          api.get("/course-units"),
          api.get("/lecturers"),
          api.get("/rooms"),
          api.get("/activities?activity_type=teaching"),
          api.get("/activities?activity_type=exam"),
          api.get("/generation/runs"),
        ]);
        setStats({
          programmes: p.data.length,
          cohorts: c.data.length,
          course_units: cu.data.length,
          lecturers: l.data.length,
          rooms: r.data.length,
          activities: a.data.length,
          exam_activities: exam.data.length,
          runs: runs.data.length,
        });
        setRecentRuns(runs.data.slice(0, 5));
      } catch {
        toast.show("err", "Failed to load dashboard");
      } finally {
        setLoading(false);
      }
    };
    load();
  }, []);

  const cards = [
    { label: "Programmes", value: stats.programmes, path: "/programmes", color: "from-blue-500 to-blue-600" },
    { label: "Cohorts", value: stats.cohorts, path: "/cohorts", color: "from-purple-500 to-purple-600" },
    { label: "Course Units", value: stats.course_units, path: "/course-units", color: "from-fuchsia-500 to-fuchsia-600" },
    { label: "Lecturers", value: stats.lecturers, path: "/lecturers", color: "from-pink-500 to-pink-600" },
    { label: "Rooms", value: stats.rooms, path: "/rooms", color: "from-violet-500 to-violet-600" },
    { label: "Teaching", value: stats.activities, path: "/activities", color: "from-indigo-500 to-indigo-600" },
    { label: "Exams", value: stats.exam_activities, path: "/activities", color: "from-amber-500 to-amber-600" },
    { label: "Runs", value: stats.runs, path: "/generate", color: "from-emerald-500 to-emerald-600" },
  ];

  const runTypeBadge = (rt: string) => {
    const colors: Record<string, string> = {
      teaching: "bg-blue-100 text-blue-700",
      test: "bg-yellow-100 text-yellow-700",
      exam: "bg-purple-100 text-purple-700",
    };
    return <span className={"px-2 py-0.5 rounded text-xs font-medium " + (colors[rt] || "")}>{rt}</span>;
  };

  const statusBadge = (s: string) => {
    const colors: Record<string, string> = {
      success: "bg-green-100 text-green-700",
      failed: "bg-red-100 text-red-700",
      running: "bg-yellow-100 text-yellow-700",
    };
    return <span className={"px-2 py-0.5 rounded text-xs font-medium " + (colors[s] || "")}>{s}</span>;
  };

  return (
    <div>
      <div className="mb-8">
        <h1 className="text-2xl md:text-3xl font-bold text-gray-900 mb-1">
          Welcome back, {user?.full_name?.split(" ")[0] || "Admin"}
        </h1>
        <p className="text-gray-500">Here is what is happening at AVIU today.</p>
      </div>

      {loading ? (
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          {Array.from({ length: 8 }).map((_, i) => <CardSkeleton key={i} />)}
        </div>
      ) : (
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          {cards.map((c) => (
            <Link key={c.label} to={c.path}
              className="bg-white rounded-xl p-5 border border-gray-200 hover:border-aviu-400 hover:shadow-md transition group">
              <div className="flex items-start justify-between mb-3">
                <span className={"w-2 h-2 rounded-full bg-gradient-to-br " + c.color}></span>
              </div>
              <div className="text-3xl font-bold text-gray-900 mb-1">{c.value}</div>
              <div className="text-sm text-gray-500 group-hover:text-aviu-800 transition">{c.label}</div>
            </Link>
          ))}
        </div>
      )}

      <div className="grid md:grid-cols-2 gap-6 mb-8">
        <div className="bg-gradient-to-br from-aviu-800 to-aviu-900 text-white rounded-xl p-6">
          <h2 className="text-xl font-bold mb-2">Generate New Timetable</h2>
          <p className="text-aviu-200 text-sm mb-4">
            Run the OR-Tools solver to create a clash-free timetable for teaching, tests, or exams.
          </p>
          <Link to="/generate"
            className="inline-block bg-white text-aviu-900 font-semibold px-4 py-2 rounded-lg hover:bg-aviu-100 transition">
            Go to Generate
          </Link>
        </div>

        <div className="bg-white border border-gray-200 rounded-xl p-6">
          <h2 className="text-xl font-bold text-gray-900 mb-2">View Latest Timetable</h2>
          <p className="text-gray-500 text-sm mb-4">
            Browse, publish, or manually adjust a generated timetable.
          </p>
          <Link to="/timetable"
            className="inline-block bg-aviu-800 text-white font-semibold px-4 py-2 rounded-lg hover:bg-aviu-900 transition">
            View Timetable
          </Link>
        </div>
      </div>

      {recentRuns.length > 0 && (
        <div className="bg-white rounded-xl border border-gray-200 p-6">
          <div className="flex items-center justify-between mb-4">
            <h2 className="text-lg font-bold text-gray-900">Recent Generation Runs</h2>
            <Link to="/generate" className="text-sm text-aviu-800 hover:underline">View all</Link>
          </div>
          <div className="space-y-2">
            {recentRuns.map((r) => (
              <div key={r.id} className="flex items-center justify-between p-3 border rounded-lg hover:bg-aviu-50 transition">
                <div>
                  <div className="flex items-center gap-2 mb-1">
                    <span className="font-medium text-sm">Run #{r.id}</span>
                    {runTypeBadge(r.run_type)}
                    {r.is_published && (
                      <span className="px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-700">
                        Published
                      </span>
                    )}
                  </div>
                  <p className="text-xs text-gray-500">{r.message}</p>
                </div>
                <div className="text-right">
                  {statusBadge(r.status)}
                  <p className="text-xs text-gray-500 mt-1">
                    {new Date(r.created_at).toLocaleDateString()}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  );
}