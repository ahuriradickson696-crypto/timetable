# App
APP_NAME=AVIU Timetable
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-64-char-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (SQLite for dev)
DATABASE_URL=sqlite:///./aviu_timetable.db

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Default admin
FIRST_ADMIN_EMAIL=admin@aviu.ac.ug
FIRST_ADMIN_PASSWORD=admin123
FIRST_ADMIN_NAME=System Administrator

# Solver
SOLVER_TIME_LIMIT_SECONDS=300
SOLVER_NUM_WORKERS=4
SOLVER_RANDOM_SEED=42
