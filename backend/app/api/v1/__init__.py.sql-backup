"""Aggregate v1 routers."""
from fastapi import APIRouter

from app.api.v1.health import router as health_router
from app.api.v1.auth import router as auth_router
from app.api.v1.programmes import router as programmes_router
# from app.api.v1.cohorts import router as cohorts_router
from app.api.v1.course_units import router as course_units_router
from app.api.v1.lecturers import router as lecturers_router
from app.api.v1.rooms import router as rooms_router
from app.api.v1.time_periods import router as time_periods_router
from app.api.v1.activities import router as activities_router
from app.api.v1.generation import router as generation_router
from app.api.v1.portal import router as portal_router
from app.api.v1.publishing import router as publishing_router
from app.api.v1.changelog import router as changelog_router
from app.api.v1.manual_edit import router as manual_edit_router
from app.api.v1.analytics import router as analytics_router
from app.api.v1.automation import router as automation_router
from app.api.v1.change_requests import router as change_requests_router
from app.api.v1.enrollments import router as enrollments_router
from app.api.v1.students import router as students_router


api_router = APIRouter()
api_router.include_router(health_router)
api_router.include_router(auth_router)
api_router.include_router(programmes_router)
# api_router.include_router(cohorts_router)
api_router.include_router(course_units_router)
api_router.include_router(lecturers_router)
api_router.include_router(rooms_router)
api_router.include_router(time_periods_router)
api_router.include_router(activities_router)
api_router.include_router(generation_router)
api_router.include_router(portal_router)
api_router.include_router(publishing_router)
api_router.include_router(changelog_router)
api_router.include_router(manual_edit_router)
api_router.include_router(analytics_router)
api_router.include_router(automation_router)
api_router.include_router(change_requests_router)
api_router.include_router(enrollments_router)
api_router.include_router(students_router)


__all__ = ["api_router"]