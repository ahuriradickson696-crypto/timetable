"""Lecturer model + LecturerModule junction."""
from sqlalchemy import String, Integer, Boolean, ForeignKey
from sqlalchemy.orm import Mapped, mapped_column, relationship
from typing import Optional, List
from app.db.base import Base, TimestampMixin


class Lecturer(Base, TimestampMixin):
    __tablename__ = "lecturers"

    id: Mapped[str] = mapped_column(String(50), primary_key=True)  # e.g. LECT-001
    full_name: Mapped[str] = mapped_column(String(255), nullable=False)
    max_hours_per_week: Mapped[int] = mapped_column(Integer, default=16, nullable=False)
    preferred_mode: Mapped[str] = mapped_column(String(20), default="Both", nullable=False)  # Day / Weekend / Both
    unavailable_days: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)  # comma-separated
    email: Mapped[Optional[str]] = mapped_column(String(255), nullable=True)
    active: Mapped[bool] = mapped_column(Boolean, default=True, nullable=False)
    notes: Mapped[Optional[str]] = mapped_column(String(1000)
    faculty: Mapped[Optional[str]] = mapped_column(String(200), nullable=True), nullable=True)

    module_links: Mapped[List["LecturerModule"]] = relationship(back_populates="lecturer")
    activities: Mapped[List["Activity"]] = relationship(back_populates="lecturer")


class LecturerModule(Base, TimestampMixin):
    """Many-to-many: which modules a lecturer can teach."""
    __tablename__ = "lecturer_modules"

    id: Mapped[int] = mapped_column(Integer, primary_key=True, autoincrement=True)
    lecturer_id: Mapped[str] = mapped_column(ForeignKey("lecturers.id"), nullable=False, index=True)
    course_unit_code: Mapped[str] = mapped_column(ForeignKey("course_units.code"), nullable=False, index=True)

    lecturer: Mapped["Lecturer"] = relationship(back_populates="module_links")
    course_unit: Mapped["CourseUnit"] = relationship(back_populates="lecturer_links")
